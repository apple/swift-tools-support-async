[flake8]

# The vendored BLAKE3 submodule is third-party code that we do not lint.
# `.build` holds generated SwiftPM output.
extend-exclude =
    ThirdParty,
    .build

extend-ignore =
    # These are needed to make our license headers pass the linting
    E265,
    E266,

# 10% larger than the standard 80 character limit. Conforms to the black
# standard and Bugbear's B950.
max-line-length = 88
